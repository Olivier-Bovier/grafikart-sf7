{% extends 'admin/admin.html.twig' %}

{% block title %}Recette : {{ recipe.title }}{% endblock %}

{% block body %}
   
  <h1>{{ recipe.title }}</h1>

    <p>
      <img src="{{ vich_uploader_asset(recipe, 'thumbnailFile')}}" alt="Image de la recette">
    </p>
    
    <turbo-frame id="recipe_{{ recipe.id }}">
      {{ form(form, {action: path('admin.recipe.edit', {id: recipe.id} )}) }}
    </turbo-frame>

  {# {{ form_start(form) }}
    <div class="d-flex">
        {{ form_row(form.title) }}
        {{ form_row(form.duration) }}
    </div>
  {{ form_end(form) }} #}
  
{% endblock %}